# Local development configuration. Copy this file to .env.
# Never commit real API keys or private farmer data.

APP_ENV=development

# Current answer generation requires internet access.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Local knowledge and retrieval artefacts.
KNOWLEDGE_BASE_DIR=knowledge_base
VECTOR_STORE_DIR=vector_store

# SQLite is stored at data/poultryguard.db by default.
